# Public URL. Keep localhost during local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional form endpoint used by the static GitHub Pages test version.
NEXT_PUBLIC_FORM_ENDPOINT=

# SMTP configuration for quote delivery.
# Gmail example: smtp.gmail.com / 465 / true, using an app password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Sender must be accepted by the SMTP provider.
QUOTE_FROM_EMAIL=
# Use your own inbox during testing. Change to the company inbox only for launch.
QUOTE_TO_EMAIL=
